APP_MODE=simulation
# DATA_DIR=/ruta/absoluta/de/datos # Raíz; se crea un subdirectorio por modo.
WHATSAPP_ENABLED=false
WHATSAPP_SEND_ENABLED=false
HOST=127.0.0.1
PORT=3210
DEFAULT_MARGIN_COP=10000
LOG_LEVEL=info
# auto: Windows prioriza WebGPU/DirectML para Florence y Qwen; usa CPU como respaldo.
IMAGE_INFERENCE_DEVICE=auto
# Trial applies supported RAG matches together with Florence + Qwen; use shadow to compare without applying.
BRAND_RAG_MODE=trial
# Automatic: 1 worker, or 2 when CPU and available memory allow it. Optional override (1–4):
# IMAGE_ANALYSIS_WORKERS=2
